# DeepSeek（Mastra 原生支持，推荐默认）
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key

# AI 模型（provider/model-name）
AI_MODEL=deepseek/deepseek-v4-flash

# 可选：其他 AI 提供商 API Key
# DASHSCOPE_API_KEY=      # 通义千问
# MOONSHOT_API_KEY=       # Kimi
# ZHIPU_API_KEY=          # 智谱 GLM
# MINIMAX_API_KEY=        # MiniMax
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=

# HTTP 服务
PORT=4000
# 可选：设置后 Web 请求须带 Authorization: Bearer <token>
# AGENT_CORE_TOKEN=your-shared-secret

# 本地后台消息雷达（agent-core serve 启动后默认开启）
# MONITOR_BACKGROUND_ENABLED=1
# MONITOR_BACKGROUND_INTERVAL_MS=300000
# 自动加池：balanced（默认）| aggressive | notify_only
# MONITOR_AUTO_TRACK=balanced
# 次日晚几点清理前一日消息雷达数据（北京时间，默认 20）
# MONITOR_PURGE_HOUR=20

# 推荐：Turso 远程数据库
# LIBSQL_URL=libsql://your-db.turso.io
# LIBSQL_AUTH_TOKEN=

# 问财 MCP（可选，用于选股 / 投委会）
# IWENCAI_API_KEY=sk-...
# IWENCAI_BASE_URL=https://openapi.iwencai.com
# IWENCAI_MCP_SERVER_PATH=/absolute/path/to/iwencai-mcp/server.py

# 可选：切换模型（推荐使用 AI_MODEL；DEEPSEEK_MODEL 仍兼容）
# AI_MODEL=deepseek/deepseek-chat
# DEEPSEEK_MODEL=deepseek/deepseek-v4-flash

# 可选：本地 A 股前复权日线 CSV 目录，文件名格式如 600519_daily_qfq.csv
# INVESTMENT_AGENT_STOCK_QFQ_DIR=/Users/wangbo/Downloads/daily_qfq
# 可选：本地 A 股代码名称表（Tushare 导出格式，或 symbol,name 两列）
# 默认读取 packages/agent-core/data/market-csv/meta/stock-list-listed.csv 与 stock-list-delisted.csv
# INVESTMENT_AGENT_STOCK_LIST_CSV=/path/to/stock-list-listed.csv
# INVESTMENT_AGENT_STOCK_DELISTED_CSV=/path/to/stock-list-delisted.csv
# INVESTMENT_AGENT_STOCK_NAME_CSV=/path/to/stock-names.csv

# 可选：收盘后逐只补齐股票本地日线 CSV。默认定时任务会更新本地已有股票池，并纳入自选/持仓/最近选股。
# INFOWAY_API_KEY=
# STOCK_DAILY_CSV_PROVIDER=auto
# STOCK_DAILY_CSV_DELAY_MS=333
# STOCK_DAILY_CSV_RETRY_ROUNDS=3
# STOCK_DAILY_CSV_RETRY_ROUND_DELAY_MS=5000
# DAILY_CSV_UPDATE_RETRIES=2
# DAILY_CSV_UPDATE_TIMEOUT_MS=5000

# 可选：百度网盘客户端下载后的 A 股数据目录。
# 该目录下可有多层子目录，脚本会查找 daily_qfq.zip、股票列表.csv、退市股票列表.csv。
# INVESTMENT_AGENT_MARKET_SYNC_SOURCE=/Users/wangbo/BaiduNetdiskDownload/A股数据_zip
